        "flicker": "subtle pulse <= 0.5Hz",
        "opacity": 0.85
      },
      "mobileBehavior": "Pure GPU CSS composite layer, 0 CPU overhead",
      "reducedMotionBehavior": "Pulse animation disabled, static gradient rendered",
