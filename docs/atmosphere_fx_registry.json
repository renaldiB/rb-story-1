        "ch2_lean_closer",
        "ch2_hold_shoulder",
        "ch2_slow_walk",
        "ch2_bus_stop"
      ],
      "parameters": {
        "angleDeg": 35,
        "dropSpeed": "14-22 px/frame",
        "dropLength": "16-26 px",
        "opacity": "0.15-0.40",
